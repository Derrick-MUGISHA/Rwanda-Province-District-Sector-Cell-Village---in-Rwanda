{
  "name": "@derrick63/rwanda-admin-hierarchy",
  "version": "1.0.0",
  "description": "Complete Rwanda administrative hierarchy dataset (Province > District > Sector > Cell > Village) with a zero-dependency lookup API and an optional Express server.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./data": "./data/rwanda-administrative.json",
    "./package.json": "./package.json"
  },
  "files": [
    "data/rwanda-administrative.json",
    "src/index.js",
    "src/index.d.ts",
    "src/data-store.js",
    "src/server.js",
    "README.md",
    "TECHNICAL_DOCUMENTATION.md"
  ],
  "scripts": {
    "build:data": "node scripts/build-json-from-pdf.js",
    "start": "node src/server.js",
    "test": "node --test",
    "validate:data": "node scripts/validate-data.js",
    "prepack": "npm run validate:data && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Derrick-MUGISHA/Rwanda-Province-District-Sector-Cell-Village---in-Rwanda.git"
  },
  "keywords": [
    "rwanda",
    "administrative-data",
    "administrative-divisions",
    "province",
    "district",
    "sector",
    "cell",
    "village",
    "geodata",
    "dataset",
    "kigali"
  ],
  "author": "Derrick Mugisha (https://github.com/Derrick-MUGISHA)",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/Derrick-MUGISHA/Rwanda-Province-District-Sector-Cell-Village---in-Rwanda/issues"
  },
  "homepage": "https://github.com/Derrick-MUGISHA/Rwanda-Province-District-Sector-Cell-Village---in-Rwanda#readme",
  "devDependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0"
  }
}
