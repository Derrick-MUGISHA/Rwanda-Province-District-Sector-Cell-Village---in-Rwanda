# Runtime
PORT=3000
ENABLE_FULL_DATASET_ENDPOINT=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000

# Comma-separated list for browser clients. Leave empty to allow all origins.
ALLOWED_ORIGINS=http://localhost:3000, http://localhost:5173

# Set to "true" (or a hop count) when running behind a reverse proxy / load balancer.
TRUST_PROXY=

# Publishing tokens do NOT belong in .env files.
# Use GitHub Actions secrets (repo Settings > Secrets and variables > Actions)
# for CI releases, and `npm login` for local publishing.
